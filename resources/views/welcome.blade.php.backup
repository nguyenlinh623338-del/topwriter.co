    <title>TopwriterX - Premium Writing Service</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .gradient-text {
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            background-image: linear-gradient(to right, #3182ce, #4338ca);
        }
        .hero-gradient {
            background: linear-gradient(135deg, #1a365d 0%, #3182ce 100%);
        }
        .grid-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }
        .feature-card {
            transition: all 0.3s ease;
        }
        .feature-card:hover {
            transform: translateY(-5px);
        }
        
        /* Research process animation */
        .research-icon {
            transition: all 0.3s ease;
        }
        .research-icon:hover {
            transform: scale(1.1);
        }
        .process-line {
            position: relative;
            height: 2px;
            background: #3182ce;
            margin: 0 8px;
            flex-grow: 1;
        }
        
        @media (max-width: 768px) {
            .grid-container {
                grid-template-columns: 1fr;
            }
            body {
                height: auto;
                overflow-y: auto;
            }
            .process-container {
                flex-direction: column;
            }
            .process-line {
                width: 2px;
                height: 20px;
                margin: 8px 0;
            }
        }
    </style>
</head>

